# Native Supabase Auth + Data API (public URL and publishable key)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer a publishable key; legacy anon keys remain supported as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# These two are server-only. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOT_SECRET=

# Email/SMS Providers (optional for now)
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=

# Encryption
# Supply a strong stable secret of at least 32 characters; never rotate without
# planning to re-encrypt historical data. Do not commit actual key material.
ENCRYPTION_KEY=
